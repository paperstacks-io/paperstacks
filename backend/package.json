{
  "name": "paperstacks-backend",
  "private": true,
  "scripts": {
    "build:web-assets": "npm run build:css && npm run build:htmx",
    "build:css": "npx @tailwindcss/cli -i ./internal/web/assets/tailwind.css -o ./internal/web/assets/styles.css --minify",
    "build:htmx": "cp node_modules/htmx.org/dist/htmx.min.js internal/web/assets/htmx.min.js",
    "watch:css": "npx @tailwindcss/cli -i ./internal/web/assets/tailwind.css -o ./internal/web/assets/styles.css --watch --minify",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:citation": "esbuild internal/web/assets/js/citation-entry.js --bundle --minify --platform=browser --format=iife --alias:node-fetch=./internal/web/assets/js/fetch-shim.js --outfile=internal/web/assets/citation.min.js"
  },
  "dependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@tailwindcss/cli": "^4.3.3",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "daisyui": "^5.7.19",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
