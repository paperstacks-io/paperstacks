{
  "name": "paperstacks-backend",
  "private": true,
  "scripts": {
    "build:web-assets": "npm run build:css && npm run build:htmx",
    "build:css": "tailwindcss -i ./internal/web/assets/tailwind.css -o ./internal/web/assets/styles.css --minify",
	"build:htmx": "node ./scripts/copy-htmx.mjs",
    "watch:css": "tailwindcss -i ./internal/web/assets/tailwind.css -o ./internal/web/assets/styles.css --watch"
  },
  "devDependencies": {
	"htmx.org": "2.0.8",
    "tailwindcss": "3.4.19"
  }
}
